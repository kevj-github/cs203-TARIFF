
########################################
# Monorepo .gitignore (frontend + server)
########################################

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS / misc
.DS_Store

# Editor/IDE
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iws
*.iml
*.ipr

# Node/Vite (frontend)
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Java/Gradle (server)
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/
out/
!**/src/main/**/out/
!**/src/test/**/out/
!server/gradle/wrapper/gradle-wrapper.jar

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Env
.env